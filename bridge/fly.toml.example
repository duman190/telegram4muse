# Example Fly.io config. Copy to fly.toml, set `app`, then see README.md.
app = "telegram4muse-bridge-CHANGE-ME"
primary_region = "sjc"

[build]

[env]
  DATA_FILE = "/data/state.json"
  PORT = "8787"

[[mounts]]
  source = "t4m_data"
  destination = "/data"

[http_service]
  internal_port = 8787
  force_https = true
  # The bridge runs a timer (scheduled jobs, fallback alerts), so keep one machine up.
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

[[http_service.checks]]
  grace_period = "10s"
  interval = "30s"
  method = "GET"
  path = "/healthz"
  timeout = "5s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
